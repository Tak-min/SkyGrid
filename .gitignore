# Wrangler (Cloudflare) local cache — accidentally uploaded as a public asset
# once when it landed inside legal/site/; see dev-notes 2026-07-30.
ios/legal/.wrangler/
ios/legal/site/.wrangler/
ios/legal/node_modules/
waitlist/.wrangler/
waitlist/site/.wrangler/
waitlist/node_modules/

# Xcode build products at repo root (XcodeBuildMCP workspace output)
/build/

# Promo pipeline intermediates: 73MB of Wikimedia source photographs. Reproducible with
# `branding/promo/fetch_skies.py` from skies_manifest.json, which IS tracked, so the
# render can be regenerated without carrying the originals in git history.
branding/promo/skies/
branding/promo/__pycache__/
branding/promo/video-v1/build/
branding/promo/out/contact-sheet.png

# In-flight media from a concurrent unrelated session — never let a loop checkpoint sweep this in.
# Rendered video work is not part of this repository. Only a subdirectory was
# ignored before, so ~9.5GB of exports and renders were tracked by accident and
# purged from history on 2026-09-06. The files themselves stay on disk.
videos/

# App Store screenshot pipeline intermediates. `store.yaml` + `capture.py` regenerate
# them from a simulator, so the raw captures and the pre-crop framed renders are not
# worth carrying. `final/` (exactly what was uploaded to ASC) and `previous/` (the
# superseded set, already deleted from ASC and therefore not re-downloadable) ARE tracked.
branding/app-store/*/raw/
branding/app-store/*/framed/
dev-notes/tools/__pycache__/
