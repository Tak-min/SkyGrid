rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function relationshipId(first, second) {
      return first < second ? first + '_' + second : second + '_' + first;
    }

    function activeBuddy(ownerUid) {
      let relationship = firestore.get(
        /databases/(default)/documents/friendships/$(relationshipId(request.auth.uid, ownerUid))
      );
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/friendships/$(relationshipId(request.auth.uid, ownerUid))
        )
        && relationship.data.members.hasAll([request.auth.uid, ownerUid])
        && relationship.data.status == 'accepted'
        && relationship.data.blockedBy.size() == 0;
    }

    function hasPostedFor(localDate) {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)/posts/$(localDate)
        );
    }

    match /posts/{uid}/{localDate}/{fileName} {
      // Match the Firestore mutual-reveal policy before sending a buddy's bytes.
      allow get: if signedIn()
        && (request.auth.uid == uid || (activeBuddy(uid) && hasPostedFor(localDate)));
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && fileName.matches('[A-Za-z0-9-]+(_thumb)?\\.jpg');
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
  }
}
