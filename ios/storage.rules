rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /posts/{uid}/{localDate}/{fileName} {
      // Shared reads are issued by the App Check-enforced imageDownloadURL
      // callable after it checks the Firestore friendship and mutual-post policy.
      // Keeping direct Storage reads owner-only avoids production failures in
      // Storage Rules' Firestore cross-service lookup path.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && fileName.matches('[A-Za-z0-9-]+(_thumb)?\\.jpg');
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
  }
}
