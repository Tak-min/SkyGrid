rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function relationshipId(first, second) {
      return first < second ? first + '_' + second : second + '_' + first;
    }

    function relationshipWith(uid) {
      return get(/databases/$(database)/documents/friendships/$(relationshipId(request.auth.uid, uid)));
    }

    function activeBuddy(uid) {
      let relationship = relationshipWith(uid);
      return signedIn()
        && exists(/databases/$(database)/documents/friendships/$(relationshipId(request.auth.uid, uid)))
        && relationship.data.members.hasAll([request.auth.uid, uid])
        && relationship.data.status == 'accepted'
        && relationship.data.blockedBy.size() == 0;
    }

    function hasPostedFor(localDate) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/posts/$(localDate));
    }

    function validProfileKeys() {
      return request.resource.data.keys().hasOnly([
        'handle', 'displayName', 'timezone', 'wakeGoalMinutes',
        'streakCurrent', 'streakLongest', 'isPro', 'createdAt'
      ]);
    }

    // The app is allowed to create only an unentitled, handle-less profile at
    // first sign-in. This gives server webhooks a durable account target before
    // onboarding while keeping streaks and entitlement fields server-owned.
    function hasDefaultInitialProfileValues() {
      return request.resource.data.displayName == 'Sky Grid member'
        && request.resource.data.timezone is string
        && request.resource.data.wakeGoalMinutes is int
        && request.resource.data.wakeGoalMinutes >= 0
        && request.resource.data.wakeGoalMinutes < 24 * 60
        && request.resource.data.streakCurrent == 0
        && request.resource.data.streakLongest == 0
        && request.resource.data.isPro == false
        && request.resource.data.createdAt == request.time;
    }

    function isDefaultInitialProfile() {
      return request.resource.data.keys().hasOnly([
          'displayName', 'timezone', 'wakeGoalMinutes',
          'streakCurrent', 'streakLongest', 'isPro', 'createdAt'
        ])
        && hasDefaultInitialProfileValues();
    }

    function isDefaultInitialProfileWithHandle() {
      return validProfileKeys()
        && request.resource.data.keys().hasAll([
          'handle', 'displayName', 'timezone', 'wakeGoalMinutes',
          'streakCurrent', 'streakLongest', 'isPro', 'createdAt'
        ])
        && request.resource.data.handle is string
        && request.resource.data.handle.matches('[a-z0-9_]{3,20}')
        && hasDefaultInitialProfileValues()
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == request.auth.uid;
    }

    function validPostKeys() {
      return request.resource.data.keys().hasOnly([
        'ownerUid', 'capturedAt', 'uploadedAt', 'imagePath', 'thumbPath',
        'skyColorHex', 'minutesFromGoal', 'reactions'
      ]);
    }

    // `localDate` (the `posts/{localDate}` document ID) was previously
    // unconstrained: only `capturedAt`/`uploadedAt` were checked against server
    // time, but nothing stopped a client from writing the *document path* itself
    // for an arbitrary past (or future) day — a backfilled Grid cell.
    //
    // CORRECTED (2026-09-04, security review — see `.loop/codex-handoff-log.md`
    // "Item 2" for the full report): this is compared against a real UTC
    // *instant* (`request.time`), not a calendar-day difference, which makes the
    // window asymmetric and tighter than "±2 days" reads: past-side, a `localDate`
    // 2 calendar days behind today is already rejected for nearly its entire day
    // (confirmed against the emulator — `isRecentLocalDate` at
    // `timestamp.date(D-2) >= request.time - 2d` only holds within a sliver of a
    // day right at the UTC-midnight boundary), so the practical past bound is
    // "yesterday, not the day before." Future-side, `timestamp.date(D+2) <=
    // request.time + 2d` holds for that entire day, so up to 2 full days of
    // future-dating is currently accepted — a known, accepted gap (see the
    // review's HIGH-1), left as-is deliberately: fixing only the past side still
    // closes the actual backfill threat (a fabricated *history*), and the
    // product owner has explicitly decided the future-dating leniency is not
    // worth the added complexity right now. `PostCreateWindowPolicy` (Swift)
    // mirrors this function's past-side behavior conservatively so the client can
    // stop offering a "Retry now" that can never succeed once a capture's
    // `localDate` has aged out (see the review's HIGH-2).
    //
    // ALSO CORRECTED (MEDIUM-1, same review): `localDate` had no format
    // constraint, so a non-canonical string like "2026-9-4" (same real day as
    // "2026-09-04") could create a second post document for a day that should
    // only ever have one — the `localDate.matches(...)` guard below closes that
    // and, as a side effect, guarantees `split('-')` always yields exactly 3
    // purely-numeric, zero-padded parts before `int()` ever sees them.
    function isRecentLocalDate(localDate) {
      let parts = localDate.split('-');
      let asOfMidnightUTC = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      return localDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && asOfMidnightUTC >= request.time - duration.value(2, 'd')
        && asOfMidnightUTC <= request.time + duration.value(2, 'd');
    }

    // A handle is optional until someone uses the buddy feature. Once set, it is
    // immutable, and its matching document must be created in the same atomic
    // write. This also supports a profile that was created before a handle.
    function isInitialHandleClaim() {
      return !resource.data.keys().hasAny(['handle'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handle'])
        && request.resource.data.handle is string
        && request.resource.data.handle.matches('[a-z0-9_]{3,20}')
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || activeBuddy(uid));
      allow list: if false;

      // A profile is born atomically with its immutable handle document.
      allow create: if signedIn()
        && request.auth.uid == uid
        && (
          isDefaultInitialProfile()
          || isDefaultInitialProfileWithHandle()
        );

      // Subscription status and streak values are server-owned. Client settings can
      // be changed without touching the identity or entitlement fields.
      allow update: if signedIn()
        && request.auth.uid == uid
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'timezone', 'wakeGoalMinutes'
          ])
          || isInitialHandleClaim()
        );
      allow delete: if false;

      match /posts/{localDate} {
        // Mutual reveal is a privacy boundary, not merely a client-side blur.
        // A buddy can read this day's post only after recording their own post for
        // the same local date.
        allow get, list: if signedIn()
          && (request.auth.uid == uid || (activeBuddy(uid) && hasPostedFor(localDate)));
        allow create: if signedIn()
          && request.auth.uid == uid
          && validPostKeys()
          && isRecentLocalDate(localDate)
          && request.resource.data.ownerUid == uid
          && request.resource.data.capturedAt <= request.time
          && request.resource.data.uploadedAt == request.time
          && request.resource.data.imagePath.matches('posts/' + uid + '/' + localDate + '/[A-Za-z0-9-]+\\.jpg')
          && request.resource.data.thumbPath.matches('posts/' + uid + '/' + localDate + '/[A-Za-z0-9-]+_thumb\\.jpg')
          && request.resource.data.skyColorHex.matches('#[A-Fa-f0-9]{6}')
          && request.resource.data.reactions.size() == 0;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /handles/{handle} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && handle.matches('[a-z0-9_]{3,20}')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle == handle;
      allow update, delete: if false;
    }

    match /friendships/{pairId} {
      allow get, list: if signedIn() && resource.data.members.hasAny([request.auth.uid]);
      // A rule cannot count accepted edges, so either client-side create or a client-side
      // pending→accepted transition would bypass the eight-buddy cap. `requestBuddy`,
      // `acceptBuddy`, and `claimInviteCode` own those transitions atomically on the
      // server. Blocking direct writes is what makes the cap real rather than advisory.
      allow create: if false;
      allow update: if signedIn()
        && resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.members == resource.data.members
        && request.resource.data.requestedBy == resource.data.requestedBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blockedBy'])
        && request.resource.data.status == resource.data.status
        && request.resource.data.blockedBy.hasOnly(resource.data.members)
        && (
          (
            request.resource.data.blockedBy.size() == resource.data.blockedBy.size() + 1
            && request.resource.data.blockedBy.hasAll(resource.data.blockedBy)
            && request.resource.data.blockedBy.hasAny([request.auth.uid])
          )
          ||
          (
            request.resource.data.blockedBy.size() + 1 == resource.data.blockedBy.size()
            && resource.data.blockedBy.hasAll(request.resource.data.blockedBy)
            && !request.resource.data.blockedBy.hasAny([request.auth.uid])
          )
        );
      allow delete: if signedIn() && resource.data.members.hasAny([request.auth.uid]);
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterUid', 'subjectUid', 'createdAt', 'status'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.subjectUid is string
        && request.resource.data.status == 'received'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /users/{uid}/devices/{tokenId} {
      allow get, list: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['fcmToken', 'updatedAt', 'platform'])
        && request.resource.data.fcmToken is string
        && request.resource.data.platform == 'ios';
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // The buddy-post-notification idempotency marker (`onBuddyPostCreated` /
    // `buddyNotificationStore.ts`). Admin-SDK-only, like `invites`/`inviteRateLimits`
    // below — kept explicit so a future top-level rule cannot accidentally treat this
    // server-owned namespace as ordinary client data.
    match /users/{uid}/postNotifications/{document=**} {
      allow read, write: if false;
    }

    // RevenueCat lifecycle webhooks write this mirror through the Admin SDK only.
    // It is never an entitlement source for the client, nor a client-writable
    // profile field.
    match /entitlements/{uid} {
      allow read, write: if false;
    }

    // Invite codes and their rate-limit counters are callable-only. Keep these
    // recursive matches explicit so a future top-level rule cannot accidentally
    // treat either server-owned namespace as ordinary client data.
    match /invites/{document=**} {
      allow read, write: if false;
    }

    match /inviteRateLimits/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
