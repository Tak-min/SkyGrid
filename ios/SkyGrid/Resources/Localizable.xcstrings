    "paywall.secondChance.status.checking.title": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Checking your App Store offer…" } },
        "ja": { "stringUnit": { "state": "translated", "value": "App Storeのオファーを確認中…" } }
      }
    },
    "paywall.features.month.title": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Browse a month at a time" } },
        "ja": { "stringUnit": { "state": "translated", "value": "月ごとに振り返る" } }
      }
    },
    "paywall.features.month.detail": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "See the photos behind every season, not a colour substitute." } },
        "ja": { "stringUnit": { "state": "translated", "value": "色だけの記録ではなく、季節ごとの写真を見られるよ。" } }
      }
    },
    "paywall.features.circle.title": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Grow an unlimited Circle" } },
        "ja": { "stringUnit": { "state": "translated", "value": "サークルを無制限に" } }
      }
    },
    "paywall.features.circle.detail": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Keep as many buddies as you like instead of Free's 5." } },
        "ja": { "stringUnit": { "state": "translated", "value": "無料版の5人制限を超えて、好きなだけバディを追加できるよ。" } }
      }
    },
    "paywall.features.together.title": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Put two skies side by side" } },
        "ja": { "stringUnit": { "state": "translated", "value": "2つの空を並べる" } }
      }
    },
    "paywall.features.together.detail": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Open and share a together card after you and a buddy both capture." } },
        "ja": { "stringUnit": { "state": "translated", "value": "自分とバディが撮影したら、トゥギャザーカードを開いてシェアできるよ。" } }
      }
    },
    "paywall.features.weekly.title": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Relive every complete week" } },
        "ja": { "stringUnit": { "state": "translated", "value": "1週間を振り返る" } }
      }
    },
    "paywall.features.weekly.detail": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Turn seven mornings into a weekly recap you can share." } },
        "ja": { "stringUnit": { "state": "translated", "value": "7日分の朝を、シェアできるウィークリーリキャップにまとめよう。" } }
      }
    },
    "paywall.features.yearShare.title": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "A full-year share card" } },
        "ja": { "stringUnit": { "state": "translated", "value": "1年分のシェアカード" } }
      }
    },
    "paywall.features.yearShare.detail": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Export the complete color record when there is a year to share." } },
        "ja": { "stringUnit": { "state": "translated", "value": "1年分たまったら、空の色の記録をまとめて書き出せるよ。" } }
      }
    },
    "paywall.features.freeDescription": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Free includes daily capture, the recent archive, and a 5-person Circle. Pro opens the full archive, month view, an unlimited Circle, together cards, and weekly recaps." } },
        "ja": { "stringUnit": { "state": "translated", "value": "無料版には毎日の撮影、直近のアーカイブ、5人までのサークルが含まれるよ。Proでは全アーカイブ、月表示、無制限のサークル、トゥギャザーカード、ウィークリーリキャップが解禁されるよ。" } }
      }
    },
    "paywall.secondChance.status.checking.detail": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "We’re verifying the real price and whether Apple can apply it to this account." } },
        "ja": { "stringUnit": { "state": "translated", "value": "実際の料金と、このアカウントに適用できるかをAppleで確認しています。" } }
      }
    },
    "paywall.secondChance.status.offline.title": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "You appear to be offline." } },
        "ja": { "stringUnit": { "state": "translated", "value": "オフラインのようです。" } }
      }
    },
    "paywall.secondChance.status.offline.detail": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "We couldn’t verify the offer with the App Store. Check your connection and try again." } },
        "ja": { "stringUnit": { "state": "translated", "value": "App Storeでオファーを確認できませんでした。通信を確認して、もう一度お試しください。" } }
      }
    },
    "paywall.secondChance.renewalNotice": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Your subscription renews monthly at the regular price shown above unless cancelled. Cancel anytime in your App Store subscriptions." } },
        "ja": { "stringUnit": { "state": "translated", "value": "サブスクリプションは、解約しない限り上記の通常料金で毎月更新されます。解約はApp Storeのサブスクリプション設定からいつでも行えます。" } }
      }
    },
    "today.walkthrough.morning.eyebrow": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "YOUR MORNING" } },
        "ja": { "stringUnit": { "state": "translated", "value": "あなたの朝" } }
      }
    },
    "today.walkthrough.morning.title": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Start with today's sky" } },
        "ja": { "stringUnit": { "state": "translated", "value": "今日の空から始めよう" } }
      }
    },
    "today.walkthrough.morning.detail": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The large card behind this guide is your daily post. Capture once each morning to continue your personal streak." } },
        "ja": { "stringUnit": { "state": "translated", "value": "このガイドの後ろにある大きなカードが、毎日の投稿だよ。毎朝1枚撮って、自分のストリークを続けよう。" } }
      }
    },
    "today.walkthrough.buddy.eyebrow": {
