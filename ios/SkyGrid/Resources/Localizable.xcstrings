    "today.walkthrough.mosaic.detail": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Open Your Mosaic to revisit the year. This Week shows your recent rhythm and unlocks the image recap." } },
        "ja": { "stringUnit": { "state": "translated", "value": "あなたのモザイクを開いて1年を振り返ろう。今週の記録では最近のリズムを見たり、画像リキャップを解禁したりできるよ。" } }
