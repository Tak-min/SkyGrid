      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Wait—want to try your first month?" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ちょっと待って！\n最初の1か月を\n試してみない？" } }
