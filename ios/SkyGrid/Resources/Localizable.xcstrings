        "en": { "stringUnit": { "state": "translated", "value": "Your skies unlock each other" } },
        "ja": { "stringUnit": { "state": "translated", "value": "お互いの空が見られるよ" } }
      }
    },
    "today.walkthrough.buddy.detail": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Scroll to Buddy Skies. After both people post, tap a large buddy card to open the full-screen feed for free." } },
        "ja": { "stringUnit": { "state": "translated", "value": "バディの空までスクロールしよう。2人とも投稿したら、大きなバディカードをタップすると無料で全画面表示できるよ。" } }
