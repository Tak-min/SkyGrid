    "welcome.moku.introduction" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A little late for introductions, but I'm Moku! Take one sky photo. Watch your year take shape." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "自己紹介が遅れたけど、Mokuっていうんだ！空を1枚撮って、1年の形を作っていこう。" } }
      }
    },
    "welcome.moku.dialogue.introduction" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A little late for introductions, but I'm Moku!" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "自己紹介が遅れたけど、Mokuっていうんだ！" } }
      }
    },
    "startup.newAccount.error" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "We couldn't prepare a new account. Check your connection and try again." } },
