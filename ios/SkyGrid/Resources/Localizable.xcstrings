      }
    },
    "startup.appleSignIn.error" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "We couldn't finish signing in with Apple. Please try again." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Apple へのサインインを完了できませんでした。もう一度お試しください。" } }
