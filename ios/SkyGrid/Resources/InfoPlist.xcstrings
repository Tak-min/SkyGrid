    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sky Grid uses the camera only to capture your morning sky. Choosing from the photo library is not available."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sky Gridは、朝の空を撮影するためだけにカメラを使用します。フォトライブラリからの選択はご利用いただけません。"
          }
        }
      }
    }
  },
  "version" : "1.0"
