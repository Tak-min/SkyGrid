// Copy this file to Secrets.xcconfig and set the real keys there.
// Secrets.xcconfig is ignored by git and must not be committed.
REVENUECAT_API_KEY_TEST = test_YOUR_TEST_STORE_KEY
REVENUECAT_API_KEY_PROD = appl_YOUR_PRODUCTION_KEY

// Before release, set a support contact and privacy policy URL that you operate.
// Xcode treats `//` as a comment in xcconfig values. `$()` expands to an
// empty string, preserving the two slashes in the final Info.plist URL.
SKYGRID_SUPPORT_URL = https:/$()/skygrid.my/support
SKYGRID_PRIVACY_POLICY_URL = https:/$()/skygrid.my/privacy
