// Copy this file to Secrets.xcconfig and set the real keys there.
// Secrets.xcconfig is ignored by git and must not be committed.
REVENUECAT_API_KEY_TEST = test_YOUR_TEST_STORE_KEY
REVENUECAT_API_KEY_PROD = appl_YOUR_PRODUCTION_KEY

// Before release, set a support contact and privacy policy URL that you operate.
SKYGRID_SUPPORT_URL = mailto:founder@example.com
SKYGRID_PRIVACY_POLICY_URL = https://example.com/sky-grid/privacy

// Optional: create and activate an App Store Connect Offer Code before setting
// these. The description must state the exact discount, duration, and renewal
// terms configured in App Store Connect. Leave both blank to omit the exit offer.
SKYGRID_EXIT_OFFER_CODE = SKYGRID20
SKYGRID_EXIT_OFFER_DESCRIPTION = 20% off your first annual term. Then renews at the current annual price unless cancelled.
